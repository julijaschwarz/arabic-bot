# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- обязательное ---
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram user ID (узнать: напишите @userinfobot). Через запятую, если нужно несколько.
ALLOWED_USER_IDS=

# --- расписание ---
TZ=Europe/Moscow
# Во сколько присылать первое задание дня
DAILY_TIME=09:00
# Сколько заданий в сессии дня
DAILY_TASK_COUNT=10
# Сколько букв держать в фокусе одного дня
FOCUS_LETTERS_PER_DAY=6
# Через сколько часов простоя напоминать «Пора повторить арабский!»
IDLE_HOURS=6
# Тихие часы: в этот интервал напоминания не приходят
QUIET_HOURS=22:00-08:00
# Как часто проверять простой (минуты)
IDLE_CHECK_MINUTES=30

# --- медиа ---
IMAGES_ENABLED=true

# --- пути внутри контейнера (менять не нужно) ---
DATA_DIR=/data
DB_PATH=/data/arabic.db

LOG_LEVEL=INFO
